SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://username:password@hostname/database

# Recommended email provider
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Admin Vote <login@yourdomain.com>

# SMTP alternative (leave blank when using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=0

# Local development only. Never set this on Vercel.
EMAIL_DELIVERY_MODE=console
